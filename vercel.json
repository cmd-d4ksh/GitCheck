{
  "buildCommand": "pip install -r requirements.txt",
  "installCommand": "pip install -r requirements.txt",
  "outputDirectory": ".",
  "framework": "python",
  "env": {
    "GITHUB_TOKEN": "@github_token"
  },
  "functions": {
    "wsgi.py": {
      "runtime": "python3.11",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/web/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/wsgi.py"
    }
  ]
}
